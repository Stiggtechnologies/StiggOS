# ───────── Supabase ─────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Vite-exposed (browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# LLM provider — pick one, or let auto-detect choose.
# ═══════════════════════════════════════════════════════════════════════════
#
# LLM_PROVIDER=auto (default) selects the first one with a key set:
#   anthropic → openai → openai_compatible (needs OPENAI_BASE_URL) → google
#
# Force a specific provider with LLM_PROVIDER=<name>.
# AI_FORCE_MOCK=1 — local dev / CI without any external calls.

LLM_PROVIDER=auto
AI_FORCE_MOCK=

# ─── Anthropic (Claude) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=                  # leave empty for api.anthropic.com
ANTHROPIC_MODEL_AGENT=claude-opus-4-7
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# ─── OpenAI (GPT) ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_AGENT=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini

# ─── OpenAI-compatible (covers most open-source + 3rd-party hosted) ─────────
# Set OPENAI_BASE_URL to any /v1 endpoint that speaks the OpenAI chat API.
# Examples:
#
#   Ollama (local)        OPENAI_BASE_URL=http://localhost:11434/v1
#                         OPENAI_MODEL_AGENT=llama3.3:70b-instruct
#                         OPENAI_MODEL_FAST=llama3.1:8b-instruct
#
#   vLLM (self-hosted)    OPENAI_BASE_URL=http://your-vllm:8000/v1
#                         OPENAI_MODEL_AGENT=meta-llama/Llama-3.3-70B-Instruct
#
#   llama.cpp server      OPENAI_BASE_URL=http://localhost:8080/v1
#
#   LM Studio             OPENAI_BASE_URL=http://localhost:1234/v1
#
#   Groq                  OPENAI_BASE_URL=https://api.groq.com/openai/v1
#                         OPENAI_API_KEY=gsk_…
#                         OPENAI_MODEL_AGENT=llama-3.3-70b-versatile
#
#   Together              OPENAI_BASE_URL=https://api.together.xyz/v1
#                         OPENAI_API_KEY=…
#                         OPENAI_MODEL_AGENT=meta-llama/Llama-3.3-70B-Instruct-Turbo
#
#   Fireworks             OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
#                         OPENAI_MODEL_AGENT=accounts/fireworks/models/llama-v3p3-70b-instruct
#
#   OpenRouter            OPENAI_BASE_URL=https://openrouter.ai/api/v1
#                         OPENAI_MODEL_AGENT=meta-llama/llama-3.3-70b-instruct
#
# Self-hosted servers usually don't require a key — leave OPENAI_API_KEY empty.
OPENAI_BASE_URL=

# ─── Google (Gemini) ────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GOOGLE_BASE_URL=                     # leave empty for generativelanguage.googleapis.com
GOOGLE_MODEL_AGENT=gemini-2.5-pro
GOOGLE_MODEL_FAST=gemini-2.5-flash

# ═══════════════════════════════════════════════════════════════════════════

# ─── Observability ─────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ─── Geo / Mapping ─────────────────────────────────────────────────────────
MAPBOX_PUBLIC_TOKEN=
VITE_MAPBOX_PUBLIC_TOKEN=

# ─── Optional — Twilio (voice / SMS for guard panic, alerts) ───────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Optional — Cyber/MSP integrations (future) ────────────────────────────
SENTINELONE_API_KEY=
CROWDSTRIKE_API_KEY=

# ─── Compliance / Region ───────────────────────────────────────────────────
DEFAULT_REGION=AB
TENANT_DEFAULT_TZ=America/Edmonton
